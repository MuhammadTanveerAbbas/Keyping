# Copy to .env.local and fill in. Never commit a real value.
# .env.local is already gitignored.

# ─── Supabase, browser safe ───────────────────────────────────────────────────
# Prefixed with VITE_ so Vite inlines them into the bundle. Never put a secret
# behind a VITE_ prefix.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# The anon or publishable key. The client accepts either variable name.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ─── Supabase, server side only ───────────────────────────────────────────────
# Set these as Vercel environment variables for the edge routes, and as Edge
# Function secrets. Never in a VITE_ variable.

# Project URL, used by the health route and the Edge Function.
SUPABASE_URL=https://your-project-id.supabase.co

# Gateway key used to ask Supabase Auth about the caller's token. Set this
# explicitly. The fallback variables below are read only if it is absent, and
# SUPABASE_SECRET_KEYS would put a secret key on that request.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Newer key format, optional. A JSON object; the handler tries anon, then
# default, then the first value.
# SUPABASE_PUBLISHABLE_KEYS={"anon":"your-key"}

# Newer secret key format, optional, last resort.
# SUPABASE_SECRET_KEYS={"secret":"your-key"}

# Authenticates the private.consume_rate_limit call. Required for rate limiting.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set automatically by Vercel. The health route uses it to allow the preview
# deployment origin. You do not need to set it yourself.

# ─── Not implemented yet ──────────────────────────────────────────────────────
# CRON_SECRET guards /api/keep-alive, but vercel.json has no crons array, so
# nothing calls that route on a schedule. See "Known gaps" in the README.
# CRON_SECRET=your-cron-secret

# Billing is on the roadmap and not implemented. See "Known gaps".
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_TEAM_PRICE_ID=price_...
